# Copy to .env.hosted locally; never commit the filled copy or share its password.
APP_ENV=hosted
APP_TZ=Asia/Manila
SESSION_DRIVER=database
# Exact HTTPS Vercel preview URL; needed when issuing private staff invitations.
APP_URL=
# Enter the separate online MySQL service values, not the laptop database values.
DB_HOST=
DB_PORT=
DB_DATABASE=defaultdb
DB_USERNAME=
DB_PASSWORD=
# Base64 of the provider's downloaded CA certificate. Configure one CA source only.
DB_SSL_CA_BASE64=
# Explicit confirmation for the CLI initializer; no setup endpoint exists.
HOSTED_SETUP_CONFIRM=initialize-lumina-demo
